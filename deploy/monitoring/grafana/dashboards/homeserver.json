      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "使用（扣除可回收缓存）",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "可用",
          "refId": "B"
        },
        {
          "expr": "node_memory_Cached_bytes{job=\"node\"}",
          "legendFormat": "页缓存",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
